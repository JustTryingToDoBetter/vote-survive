+export type TeamChallengeCategory = "bible" | "memory" | "teamwork" | "speed" | "strategy";
+
+export type TeamChallengeDefinition = {
+  id: string;
+  title: string;
+  category: TeamChallengeCategory;
+  description: string;
+};
+
+/**
+ * Core product rule:
+ * Every member of an eligible team participates unless a challenge explicitly
+ * says that it needs a captain or representative.
+ */
+export const teamChallenges: TeamChallengeDefinition[] = [
+  {
+    id: "bible-book-chain",
+    title: "Bible Book Chain",
+    category: "bible",
+    description:
+      "Teams alternate naming books of the Bible. A different teammate must answer every turn. Repeat, hesitate for 3 seconds, or answer incorrectly and your team is out.",
+  },
+  {
+    id: "bible-hunt-relay",
+    title: "Bible Hunt Relay",
+    category: "bible",
+    description:
+      "The host announces four Bible references. Each teammate must find one reference before tagging the next player. First team to complete the relay wins.",
+  },
+  {
+    id: "rapid-fire-rotation",
+    title: "Rapid Fire Rotation",
+    category: "bible",
+    description:
+      "Teams receive rapid-fire questions for 45 seconds. After every answer, the next teammate must answer. No player may answer twice until everyone has played.",
+  },
+  {
+    id: "event-order",
+    title: "Timeline Scramble",
+    category: "bible",
+    description:
+      "Teams receive Bible events in the wrong order. Work together to arrange them chronologically. Every teammate must place or verify at least one event. First correct team wins.",
+  },
+  {
+    id: "verse-puzzle",
+    title: "Verse Scramble",
+    category: "bible",
+    description:
+      "A Bible verse is split into pieces. Teams race to reconstruct the verse correctly and identify its reference. Every teammate must place or verify at least one piece.",
+  },
+  {
+    id: "memory-table",
+    title: "Memory Rush",
+    category: "memory",
+    description:
+      "The host reveals a board of items for 15 seconds. It disappears. Teams work together to write down as many correct items as possible, with every teammate contributing.",
+  },
+  {
+    id: "silent-line",
+    title: "Silent Line-Up",
+    category: "teamwork",
+    description:
+      "Without speaking, teams must arrange themselves according to the host's rule. The whole team must be correctly ordered. First team finished wins.",
+  },
+  {
+    id: "three-clue-character",
+    title: "Who Am I?",
+    category: "bible",
+    description:
+      "The host reveals Bible-character clues one at a time. Teams discuss together and may submit only one guess. Earlier correct guesses score higher.",
+  },
+  {
+    id: "category-blitz",
+    title: "Category Blitz",
+    category: "speed",
+    description:
+      "The host announces a category such as Kings of Israel, Women in the Bible, or New Testament books. Teams have 30 seconds to produce as many valid answers as possible, rotating through every teammate.",
+  },
+  {
+    id: "answer-board",
+    title: "Lock It In",
+    category: "strategy",
+    description:
+      "Every team discusses the same question and secretly locks in one answer. Every teammate must contribute before the team locks in. Reveal all answers simultaneously.",
+  },
+  {
+    id: "bible-connect",
+    title: "Connect",
+    category: "bible",
+    description:
+      "Teams receive two Bible characters, places, or events and must identify the connection between them. Build one verified explanation together. First correct team wins.",
+  },
+  {
+    id: "four-corners",
+    title: "Choose Your Corner",
+    category: "speed",
+    description:
+      "Four possible answers are assigned to four parts of the room. Teams discuss quickly, then everyone must move to their team's chosen answer before time expires.",
+  },
+  {
+    id: "team-code",
+    title: "Crack the Code",
+    category: "strategy",
+    description:
+      "Each solved Bible clue reveals part of a final code. Teams divide the clues among themselves and combine their answers to unlock the final solution.",
+  },
+];
